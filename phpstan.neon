includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Trait ini dipakai oleh komponen Livewire di resources/views, yang tidak
        # ikut dipindai karena berkas Blade bukan PHP murni. Jadi "tidak terpakai"
        # di sini keliru, bukan kode mati.
        -
            identifier: trait.unused
            path: app/Concerns/ProfileValidationRules.php
